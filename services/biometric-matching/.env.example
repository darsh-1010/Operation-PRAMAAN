PORT=8003
LOG_LEVEL=info

# Database (PostgreSQL 14+) — either set DATABASE_URL directly, or leave it blank and use
# the individual POSTGRES_* vars below. Neither reachable? Falls back to in-memory SQLite
# automatically (fine for local dev, results just don't survive a restart).
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_SIZE=5

# Redis — caches full /screen results by uploaded-file content hash, so an identical
# re-submission skips the face pipeline. Leave blank to disable caching.
REDIS_URL=redis://127.0.0.1:6379/0

# Isolated worker processes for the actual face pipeline call (see inference_pool.py) — each
# holds its own copy of the face models once warmed, so raise this only if you have the RAM.
INFERENCE_WORKERS=1

# Per-client rate limit on the public /screen endpoint (see rate_limit.py)
SCREEN_RATE_LIMIT=30/minute

# risk-scoring-engine — /screen pushes this module's score there after computing it
RISK_ENGINE_URL=http://localhost:8004
