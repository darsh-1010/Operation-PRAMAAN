PORT=8004
LOG_LEVEL=info

# Database (PostgreSQL 14+) — either set DATABASE_URL directly, or leave it blank and use
# the individual POSTGRES_* vars below. Neither reachable? Falls back to in-memory SQLite
# automatically (fine for local dev, results just don't survive a restart).
DATABASE_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_SIZE=5

# Where OCR/biometric-matching's own risk-engine pushes go — this service doesn't call out
# anywhere except OCR_CALLBACK_URL below.
OCR_CALLBACK_URL=

# Redis — required for the pending/result store to work across more than one instance of
# this service (see store.py). Leave blank to fall back to an in-process dict (single
# instance only, fine for local dev).
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------------------------
# Blockchain anchoring (see LEDGER.md). Leave CHAIN_RPC_URL blank to switch the ledger off —
# screening is unaffected either way; decisions just aren't anchored.
#
# DEV (docker compose, local Anvil chain): the values below work as-is. The key is Anvil's
# PUBLIC default account #0 — known to everyone, never a secret — and chain.py refuses to use
# it on any chain other than local dev (chain id 31337). Inside docker compose the RPC URL is
# overridden to http://anvil:8545.
#
# DEMO (Polygon Amoy testnet, free):
#   CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
#   CHAIN_EXPLORER_URL=https://amoy.polygonscan.com
#   ANCHOR_PRIVATE_KEY=<a NEW wallet's key, funded from a faucet — never commit it>
#   ANCHOR_CONFIRMATIONS=3
#   then run `python deploy_contract.py --deploy` once and paste the printed ANCHOR_CONTRACT_ADDRESS.
# ---------------------------------------------------------------------------------------------
CHAIN_RPC_URL=http://127.0.0.1:8545
ANCHOR_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHAIN_EXPLORER_URL=
# How often new decisions are sealed + anchored. 30s is for demos; 600 (10 min) in production
# = ~144 tx/day whatever the screening volume.
ANCHOR_INTERVAL_SECONDS=30
ANCHOR_MAX_BATCH=1024
# Blocks to wait after the anchor tx mines before marking the batch CONFIRMED.
ANCHOR_CONFIRMATIONS=1
