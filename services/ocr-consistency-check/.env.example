# OCR & Consistency Check Service Environment Configuration
PORT=8001
HOST=0.0.0.0
DEBUG=false

# Database Configuration (PostgreSQL 14+)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/postgres
POSTGRES_POOL_SIZE=5

# Redis — caches full /screen results by uploaded-file content hash, so an identical
# re-submission skips OCR/watchlist work. Leave blank to disable caching (every request
# runs the full pipeline).
REDIS_URL=redis://127.0.0.1:6379/0

# Isolated worker processes for the actual OCR call (see inference_pool.py) — each holds its
# own copy of the OCR model once warmed, so raise this only if you have the RAM to spare.
INFERENCE_WORKERS=1

# Per-client rate limit on the public /screen endpoint (see rate_limit.py)
SCREEN_RATE_LIMIT=30/minute

# OCR Configuration
OCR_ENGINE=paddleocr
USE_ANGLE_CLS=true
ENABLE_MKLDNN=true
CPU_THREADS=4
OCR_LANG=en

# risk-scoring-engine — /screen pushes this module's flag+score there after computing them
RISK_ENGINE_URL=http://localhost:8004
