PORT=8002
LOG_LEVEL=info

# risk-scoring-engine — /screen pushes this module's flag + tamper score there after computing it
RISK_ENGINE_URL=http://localhost:8004

# Redis — backs the /screen rate limiter (see rate_limit.py) so the limit is shared across
# every uvicorn worker instead of reset per process. Leave blank for an in-process fallback
# (single instance only, fine for local dev).
REDIS_URL=redis://127.0.0.1:6379/0
SCREEN_RATE_LIMIT=30/minute
