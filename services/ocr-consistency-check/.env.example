# OCR & Consistency Check Service Environment Configuration
PORT=8001
HOST=0.0.0.0
DEBUG=false

# Database Configuration (PostgreSQL 14+)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/postgres
POSTGRES_POOL_SIZE=5

# Redis — caches full /screen results by uploaded-file content hash, so an identical
# re-submission skips OCR/watchlist work. Leave blank to disable caching (every request
# runs the full pipeline).
REDIS_URL=redis://127.0.0.1:6379/0

# Isolated worker processes for the actual OCR call (see inference_pool.py) — each holds its
# own copy of the OCR model once warmed, so raise this only if you have the RAM to spare.
INFERENCE_WORKERS=1

# Per-client rate limit on the public /screen endpoint (see rate_limit.py)
SCREEN_RATE_LIMIT=30/minute

# OCR Configuration
OCR_ENGINE=paddleocr
USE_ANGLE_CLS=true
ENABLE_MKLDNN=true
CPU_THREADS=4
OCR_LANG=en

# risk-scoring-engine — /screen pushes this module's flag+score there after computing them
RISK_ENGINE_URL=http://localhost:8004

# Must equal risk-scoring-engine's RISK_TOKEN_OCR (>= 32 chars). Without it, results are not sent.
RISK_ENGINE_TOKEN=change-me-to-a-long-random-token-shared-with-risk-engine

# Encrypted evidence store (evidence.py): base64 of 32 random bytes. Generate with
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Same value in biometric-matching. Losing it = losing every stored file.
EVIDENCE_KEY=
EVIDENCE_DIR=/data/evidence

# Aadhaar Secure QR verification — folder of UIDAI certificates (see certs/uidai/README.md)
UIDAI_CERT_DIR=certs/uidai

# Nepali citizenship certificates have no central registry to check against; true = always
# route them to an officer (recommended). Policy decision — change only with sign-off.
NP_CITIZENSHIP_REQUIRE_REVIEW=true
